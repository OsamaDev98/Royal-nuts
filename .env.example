# ═══════════════════════════════════════════════════════════
#  Royal Nuts Factory — Environment Variables
#  Copy this file to .env and fill in your actual values.
# ═══════════════════════════════════════════════════════════

# ── Database (PostgreSQL / Supabase) ────────────────────────
# Get this from your Supabase project → Settings → Database → Connection String
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# ── Public site URL (used for sitemap, OG tags, canonical) ──
NEXT_PUBLIC_BASE_URL="https://royalnuts.com"

# ── Node environment ─────────────────────────────────────────
NODE_ENV="production"
